# Porta HTTP (default 3751)
TESTER_API_PORT=3751

# Chiave per scaricare tutti i contributi (solo tu: header Authorization: Bearer <valore>)
TESTER_API_ADMIN_KEY=cambia-questa-chiave-lunga

# Opzionale: richiesta per accettare POST dai collaboratori (header X-Contribute-Key)
# Se vuota, i POST sono aperti (ok in dev dietro firewall)
TESTER_API_CONTRIBUTE_KEY=

# Dove salvare il file jsonl (default ./data nel cwd dell’app)
# TESTER_API_DATA_DIR=/var/lib/tester-api

# Origini CORS separate da virgola, o * (default * per semplicità su deploy piccolo)
# TESTER_API_CORS_ORIGINS=https://tuosito.altervista.org,http://localhost:3002
#
# Pubblico (nessuna chiave): GET /api/waza-accessori — elenco condizioni/status/counter
# dinamici per il tester che ha VITE_TESTER_API_URL puntato qui.
#
# ── Login collaboratori (opzionale ma consigliato in produzione) ──
# Se imposti ENTRAMBI, POST /api/contributions richiede Authorization: Bearer <JWT>
# (il tester lo invia dopo il login su /api/auth/login).
# Genera TESTER_COLLAB_USERS con:
#   bun scripts/prepare-collab-env.ts .collab-secrets.txt
# (vedi .collab-secrets.example.txt — non committare le password vere)
# TESTER_JWT_SECRET=
# TESTER_COLLAB_USERS=
#
# GET /api/auth/config → { "collabLoginRequired": true|false }
# GET /api/contributions/catalog — JWT collaboratore (riepilogo voci)
# GET /api/contributions/:id — JWT collaboratore (dettaglio JSON)
