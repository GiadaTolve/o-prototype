# Copia come `.altervista-deploy.env` e compila (il file reale è gitignored).
# Pannello Altervista → Strumenti → Account FTP (host, utente, password).

ALTERVISTA_FTP_HOST=ftp.tuonome.altervista.org
ALTERVISTA_FTP_USER=tuonome
ALTERVISTA_FTP_PASSWORD=

# Solo se il pannello indica FTPS esplicito:
# ALTERVISTA_FTP_SECURE=true

# Se dopo il login FTP non sei già nella cartella del sito, indica il path (raro):
# ALTERVISTA_FTP_DIR=public_html

# Debug log FTP lato client:
# FTP_VERBOSE=1

# URL pubblico del backend apps/tester-api (HTTPS, senza slash finale).
# Viene scritto nel <meta name="oyasumi-tester-api"> di dist/index.html prima dell’upload,
# così login collaboratori e salvataggi funzionano senza ricompilare con .env.production.
# ALTERVISTA_TESTER_API_URL=https://tuo-tester-api.example.com
