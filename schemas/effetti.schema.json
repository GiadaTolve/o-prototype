          "$ref": "#/$defs/triggerEnum"
        },
        "bersaglio": {
          "$ref": "#/$defs/bersaglioEnum"
        },
        "durata": {
          "$ref": "#/$defs/durata"
        },
        "condizione": {
          "$ref": "#/$defs/condizioneCanonica"
        },
        "costo_extra": {
          "$ref": "#/$defs/costoExtra"
