            "Media",
            "Grande"
          ]
        },
        "consistenza": {
          "type": "string",
          "minLength": 1
        },
        "resistenza": {
          "$ref": "#/$defs/valore"
        },
        "danno": {
          "$ref": "#/$defs/valore"
        },
        "gittata_controllo_m": {
          "type": "number",
