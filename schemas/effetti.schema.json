            "tag": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            }
          }
        }
      },
      "required": [
        "tipo",
        "trigger",
        "bersaglio",
        "durata",
        "valore"
      ]
    },
    "bloccoBuffSkiru": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "const": "BUFF_SKIRU"
        },
        "trigger": {
          "$ref": "#/$defs/triggerEnum"
        },
        "bersaglio": {
          "$ref": "#/$defs/bersaglioEnum"
        },
        "durata": {
          "$ref": "#/$defs/durata"
        },
        "condizione": {
          "$ref": "#/$defs/condizioneCanonica"
        },
        "costo_extra": {
          "$ref": "#/$defs/costoExtra"
        },
        "nota_master": {
          "type": "string"
        },
        "skiru": {
          "type": "string",
          "minLength": 1
        },
        "valore": {
          "$ref": "#/$defs/valore"
        },
        "conta_junkan": {
          "type": "boolean"
        }
      },
      "required": [
        "tipo",
        "trigger",
        "bersaglio",
        "durata",
        "skiru",
        "valore"
      ]
    },
    "bloccoApplicaStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
